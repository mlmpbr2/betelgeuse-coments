# ---- Supabase / Prisma ----
# URL via connection pooler (porta 6543) usada pela aplicacao
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL direta (porta 5432) usada por migrations (prisma db push/migrate)
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres"

# ---- Supabase JS client (opcional, uso client-side) ----
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY="SUA_SUPABASE_ANON_KEY"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="SEU_NEXTAUTH_SECRET"

# ---- Meta / Facebook App (login Instagram Business) ----
FACEBOOK_CLIENT_ID="SEU_META_APP_ID"
FACEBOOK_CLIENT_SECRET="SEU_META_APP_SECRET"
