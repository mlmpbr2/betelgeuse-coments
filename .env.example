# ---- Supabase / Prisma ----
# URL via connection pooler (porta 6543) usada pela aplicacao
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL direta (porta 5432) usada por migrations (prisma db push/migrate)
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres"

# ---- Supabase JS client (opcional, uso client-side) ----
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY="SUA_SUPABASE_ANON_KEY"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="SEU_NEXTAUTH_SECRET"

# ---- Meta App (fluxo "Instagram API with Instagram Login") ----
# ATENCAO: use o INSTAGRAM APP ID e INSTAGRAM APP SECRET
# (painel developers.facebook.com -> seu app -> Instagram -> API setup with Instagram Login)
# NAO confundir com o App ID/Secret principal do app Meta.
FACEBOOK_CLIENT_ID="SEU_INSTAGRAM_APP_ID"
FACEBOOK_CLIENT_SECRET="SEU_INSTAGRAM_APP_SECRET"
# No painel Meta, cadastre como "URI de redirect OAuth valida":
#   dev:  http://localhost:3000/api/auth/callback/instagram
#   prod: https://SEU_DOMINIO/api/auth/callback/instagram
